# --- Database (Supabase Postgres + pgvector) ---
# Use the POOLED connection string (port 6543, transaction pooler) for the app at runtime.
# Use the DIRECT connection string (port 5432) for Alembic migrations.
# Both need the +asyncpg driver in the scheme, and any special characters in the
# password (e.g. "@") must be percent-encoded or the URL will fail to parse.
DATABASE_URL=
DATABASE_URL_DIRECT=

# --- Gemini ---
# Verified live against a real API key as of 2026-09-06: gemini-2.5-flash is retired for
# new keys (404), gemini-3.6-flash is current but capped at 20 requests/day on the free
# tier, gemini-3.5-flash-lite has a separate/workable free-tier quota. If you hit a 404,
# check https://ai.google.dev/gemini-api/docs/models for the current name; if you hit a
# 429 RESOURCE_EXHAUSTED, try a different model - quotas are tracked per model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Twilio WhatsApp Sandbox ---
# TWILIO_WHATSAPP_FROM must include the "whatsapp:" prefix, e.g. whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Decision Engine thresholds ---
CONFIDENCE_THRESHOLD=0.75
HIGH_VALUE_THRESHOLD=200.00

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
